<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      BİLEREK EKLENMEYEN İZİN: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS

      Google Play politikaları, uygulamanın çekirdek işlevi etkilenmediği
      sürece Doze/App Standby'dan DOĞRUDAN muafiyet istemeyi yasaklıyor.
      Bir söz uygulaması bu istisnaya girmez; izni bildirmek Play
      incelemesinde red veya askıya alma riski taşır.

      Bunun yerine notif/TeslimatYardimi.kt kullanıcıyı sistem ayarlarına
      YÖNLENDİRİYOR (ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS) — bu
      izin gerektirmez ve politikaya uygundur.
    -->

    <application
        android:name=".AzimUygulamasi"
        android:allowBackup="true"
        android:fullBackupContent="@xml/yedekleme_eski"
        android:dataExtractionRules="@xml/yedekleme_kurallari"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/uygulama_adi"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Azim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Azim.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/kisayollar" />
        </activity>

        <receiver
            android:name=".notif.FavoriAlicisi"
            android:exported="false" />

        <receiver
            android:name=".widget.AzimWidgetSaglayici"
            android:exported="true"
            android:label="@string/uygulama_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/azim_widget_bilgi" />
        </receiver>

        <activity android:name=".widget.WidgetAyarActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.WidgetEkleAlicisi" android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>

        <receiver
            android:name=".notif.AcilisAlicisi"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
